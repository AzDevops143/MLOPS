# Weights & Biases Configuration
WANDB_API_KEY=WANDB_API_KEY

# Hugging Face Configuration
HF_TOKEN=HF_TOKEN
HF_USERNAME=HF_USERNAME

# Model Configuration
MODEL_NAME=distilbert-base-cased
MAX_LENGTH=512

# Training Configuration
EPOCHS=3
BATCH_SIZE=16
LEARNING_RATE=3e-5

# Data Configuration
DATA_FILE=data.csv
TEXT_COLUMN=review
LABEL_COLUMN=genre

# Device Configuration
DEVICE=cuda  # use GPU only ('cuda' for GPU, 'cpu' for CPU)
